{
  "$schema": "https://opencode.ai/config.json",
  // Theme configuration
  "theme": "opencode",
  "model": "openrouter/x-ai/grok-4.1-fast",
  "autoupdate": true,
  "tools": {
    "write": false,
    "bash": true,
    "webfetch": true
  },
  "lsp": {
    "cairo-lsp": {
      "command": ["cairo-language-server", "--stdio"],
      "extensions": [".cairo"]
    }
  }
}
