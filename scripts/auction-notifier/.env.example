# Discord Webhook URL (get from Discord Server Settings > Integrations > Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Twitter API v2 credentials (get from developer.twitter.com)
TWITTER_API_KEY=your_api_key
TWITTER_API_SECRET=your_api_secret
TWITTER_ACCESS_TOKEN=your_access_token
TWITTER_ACCESS_SECRET=your_access_secret

# Torii GraphQL endpoint
TORII_URL=https://api.cartridge.gg/x/survivor-exchange/torii/graphql

# Polling interval in milliseconds (default: 5 minutes)
POLL_INTERVAL=300000

# Your site URL
SITE_URL=https://survivor.exchange
